# Porta do servidor (3101 pra nao conflitar com Rota/GLM em :3001)
PORT=3101

# Banco de dados SQLite
DATABASE_PATH=./data/publi-legal.sqlite

# JWT (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=troque_este_segredo_em_producao_use_64_chars_minimo_aqui

# Origens permitidas (CORS) - lista separada por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3101

# Em DEV, permite cookie cross-port (localhost) sem Secure flag
COOKIE_INSECURE_DEV=1

# Ambiente
NODE_ENV=development
